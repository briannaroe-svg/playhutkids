# Copy this file to .env for local development.
# In production (Render), set these as environment variables in the dashboard — never commit .env.

# Neon (or Render Postgres) connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# This backend's own public URL — required for remote agreement signing links to resolve correctly
APP_URL=https://little-playhut-backend.onrender.com

# Stripe — use TEST mode keys until ready to go live
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (for sending invoices and remote signing links — nodemailer)
EMAIL_USER=
EMAIL_PASS=

PORT=3000
